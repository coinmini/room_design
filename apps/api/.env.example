# 默认使用仓库 .local/room_design.db；需要 PostgreSQL 时取消下一行注释并修改用户/库名
# DATABASE_URL=postgresql+psycopg://user@localhost/room_design
# 默认使用仓库 .local/artifacts；需要自定义时填写绝对路径
# ARTIFACT_DIR=/absolute/path/to/room_design/.local/artifacts
BLENDER_BIN=/Applications/Blender.app/Contents/MacOS/Blender
BLENDER_ENABLED=true
FLOORPLAN_VISION_PROVIDER=kuyao
KUYAO_API_KEY=
# 可选兼容别名；KUYAO_API_KEY 为空时后端才读取它
OPENAI_API_KEY=
KUYAO_BASE_URL=https://www.kuyaoapi.com/v1
KUYAO_VISION_MODEL=gpt-5.6-sol
KUYAO_VISION_TIMEOUT_SECONDS=300
FLOORPLAN_FINAL_IMAGE_PROVIDER=auto
KUYAO_IMAGE_MODEL=gpt-image-2
KUYAO_IMAGE_QUALITY=high
KUYAO_IMAGE_TIMEOUT_SECONDS=900
KUYAO_STYLE_REFERENCE_IMAGE=
FLOORPLAN_AI_ENDPOINT=http://127.0.0.1:8189/v1/enhance
FLOORPLAN_AI_HEALTH_ENDPOINT=http://127.0.0.1:8189/health
FLOORPLAN_AI_TOKEN=
FLOORPLAN_AI_TIMEOUT_SECONDS=900
FLOORPLAN_AI_PROBE_TIMEOUT_SECONDS=1.5
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
