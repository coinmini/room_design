# ComfyUI must already be installed, running, and have this checkpoint available.
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors
COMFYUI_REFINER_CHECKPOINT=
COMFYUI_REFINER_STEPS=20
COMFYUI_REFINER_CFG=5.0
COMFYUI_REFINER_DENOISE=0.20

# Optional IP-Adapter Plus style reference. The reference must be a local PNG.
COMFYUI_IPADAPTER_MODEL=
COMFYUI_IPADAPTER_CLIP_VISION=
COMFYUI_IPADAPTER_REFERENCE_IMAGE=
COMFYUI_IPADAPTER_WEIGHT=0.60
COMFYUI_IPADAPTER_STYLE_BOOST=1.10
COMFYUI_IPADAPTER_END_PERCENT=0.85
# Set these only after a compatible SDXL ControlNet model is installed.
COMFYUI_CONTROLNET_MODEL=
COMFYUI_CONTROL_IMAGE=auto
COMFYUI_CONTROL_STRENGTH=0.88
COMFYUI_CONTROL_END_PERCENT=1.0

COMFYUI_HTTP_TIMEOUT_SECONDS=15
COMFYUI_GENERATION_TIMEOUT_SECONDS=900
COMFYUI_POLL_INTERVAL_SECONDS=0.5

COMFYUI_STEPS=28
COMFYUI_CFG=5.5
COMFYUI_SAMPLER=dpmpp_2m_sde
COMFYUI_SCHEDULER=karras
COMFYUI_MAX_GENERATION_SIDE=1280
ENHANCER_MAX_IMAGE_BYTES=26214400
